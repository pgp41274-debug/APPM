+/// Note, before any frame sees it, whether each press comes from a finger: the browser's
+/// `pointerType`. (A frame can run between a tap's `pointerdown` and its `touchstart`.)
+#[cfg(target_arch = "wasm32")]
+fn watch_pointer_type(touch: std::sync::Arc<std::sync::atomic::AtomicBool>) {
+    use eframe::wasm_bindgen::{JsCast, JsValue, closure::Closure};
+    let Some(window) = web_sys::window() else { return };
+    let handler = Closure::<dyn FnMut(web_sys::Event)>::new(move |event: web_sys::Event| {
+        let finger = js_sys::Reflect::get(&event, &JsValue::from_str("pointerType")).ok().and_then(|t| t.as_string()).is_some_and(|t| t == "touch");
+        touch.store(finger, std::sync::atomic::Ordering::Relaxed);
+    });
+    // In the capture phase: ahead of the page's own handlers.
+    if window.add_event_listener_with_callback_and_bool("pointerdown", handler.as_ref().unchecked_ref(), true).is_ok() {
+        handler.forget();
+    }
+}
