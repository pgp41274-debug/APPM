+    /// A 1000 x 700 screen (a tablet), with the panel under the page or, with `side`, beside it.
+    fn tablet(side: bool) -> Harness<'static, PdfCraftApp> {
+        let mut h = Harness::builder().with_size(egui::vec2(1000.0, 700.0)).build_eframe(move |_| {
+            let mut app = PdfCraftApp::new();
+            app.set_option("language", "en").unwrap();
+            app.host_chrome = true;
+            app.host_side_panel = side;
+            app.open_bytes("long.pdf", None, crate::canvas::touch_tests::long_pdf(3)).unwrap();
+            app
+        });
+        h.run_steps(8);
+        h
+    }
+
+    #[test]
+    fn a_tablet_docks_the_panel_beside_the_page_and_a_phone_under_it() {
+        for side in [false, true] {
+            let mut h = tablet(side);
+            assert!(state(&h)["panelRect"].is_null(), "no panel open yet");
+            ask(&mut h, HostRequest::Panel(Some("Pages".into())));
+            h.run_steps(4);
+            let r = state(&h)["panelRect"].clone();
+            let (x, y, w, hgt) = (r["x"].as_f64().unwrap(), r["y"].as_f64().unwrap(), r["w"].as_f64().unwrap(), r["h"].as_f64().unwrap());
+            let pages = h.state().views[0].visible_page_rects();
+            let right_edge = pages.iter().map(|(_, r)| r.right()).fold(0.0_f32, f32::max);
+            if side {
+                assert!(x > 500.0 && (300.0..=440.0).contains(&w) && hgt > 600.0, "beside the page: {r}");
+                assert!(f64::from(right_edge) <= x + 1.0, "the pages stay clear of the panel ({right_edge} vs {x})");
+            } else {
+                assert!(w > 900.0 && y > 250.0 && hgt < 400.0, "under the page: {r}");
+            }
+            ask(&mut h, HostRequest::Panel(None));
+            assert!(state(&h)["panelRect"].is_null());
+        }
+    }
