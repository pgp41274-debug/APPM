+#[cfg(test)]
+mod rail_tests {
+    use super::*;
+    use egui_kittest::{Harness, kittest::Queryable};
+
+    /// PdfCraft with a document open, in a window `height` points tall.
+    fn shown(height: f32) -> Harness<'static, PdfCraftApp> {
+        let mut h = Harness::builder().with_size(egui::vec2(900.0, height)).build_eframe(|_| {
+            let mut app = PdfCraftApp::new();
+            app.set_option("language", "en").unwrap();
+            app.open_bytes("form.pdf", None, include_bytes!("../tests/data/form.pdf").to_vec()).unwrap();
+            app
+        });
+        h.run_steps(8);
+        h
+    }
+
+    /// The top of the page controls at the rail's foot (page number field, Previous page, ...).
+    fn page_controls_top(h: &Harness<'static, PdfCraftApp>) -> f32 {
+        let field = h
+            .get_all_by_role(egui::accesskit::Role::TextInput)
+            .map(|n| n.rect())
+            .filter(|r| r.center().x > 900.0 - 48.0)
+            .map(|r| r.top())
+            .fold(f32::INFINITY, f32::min);
+        field.min(h.get_by_label("Previous page").rect().top())
+    }
+
+    #[test]
+    fn the_rail_shows_every_panel_button_when_there_is_room() {
+        let h = shown(900.0);
+        assert!(h.query_all_by_label("More").all(|n| n.rect().center().x < 900.0 - 48.0));
+        let tags = h.get_by_label("Tags").rect();
+        assert!(tags.bottom() <= page_controls_top(&h), "Tags {tags:?} runs into the page controls");
+    }
+
+    #[test]
+    fn a_phone_held_sideways_keeps_the_page_controls_clear() {
+        // A phone's landscape height: the view buttons go, and the panels are behind More.
+        let h = shown(380.0);
+        let more = h.get_all_by_label("More").map(|n| n.rect()).find(|r| r.center().x > 900.0 - 48.0).expect("a More button in the rail");
+        assert!(more.bottom() <= page_controls_top(&h), "More {more:?} runs into the page controls");
+        assert!(h.query_by_label_contains("Rotate view clockwise").is_none() && h.query_by_label("Toggle fit page / fit width").is_none());
+        assert!(h.get_by_label_contains("Zoom out").rect().bottom() <= 380.0);
+    }
+
+    #[test]
+    fn a_short_rail_puts_the_buttons_that_dont_fit_in_a_more_menu() {
+        let mut h = shown(420.0);
+        let more = h.get_all_by_label("More").map(|n| n.rect()).find(|r| r.center().x > 900.0 - 48.0).expect("a More button in the rail");
+        assert!(more.bottom() <= page_controls_top(&h), "More {more:?} runs into the page controls");
+        assert!(h.get_by_label("Comments").rect().bottom() <= more.top());
+        assert!(h.query_by_label("Tags").is_none(), "Tags is in the More menu");
+        let more_node = h.get_all_by_label("More").find(|n| n.rect().center().x > 900.0 - 48.0).expect("the rail's More button");
+        more_node.click();
+        h.run_steps(3);
+        h.get_by_label("Tags").click();
+        h.run_steps(3);
+        assert_eq!(h.state().right, Some(RightPanel::Tags));
+    }
+}
