+#[cfg(test)]
+mod touch_tests {
+    use crate::PdfCraftApp;
+    use egui::{Event, PointerButton, TouchDeviceId, TouchId, TouchPhase, pos2};
+    use egui_kittest::Harness;
+
+    /// A PDF of `pages` Letter pages, each with a line of text.
+    fn long_pdf(pages: usize) -> Vec<u8> {
+        let mut objs = vec![
+            "<< /Type /Catalog /Pages 2 0 R >>".to_string(),
+            format!("<< /Type /Pages /Kids [{}] /Count {pages} >>", (0..pages).map(|n| format!("{} 0 R", 4 + 2 * n)).collect::<Vec<_>>().join(" ")),
+            "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>".to_string(),
+        ];
+        for n in 0..pages {
+            let stream = format!("BT /F1 36 Tf 72 680 Td (Page {}) Tj ET", n + 1);
+            objs.push(format!(
+                "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents {} 0 R /Resources << /Font << /F1 3 0 R >> >> >>",
+                5 + 2 * n
+            ));
+            objs.push(format!("<< /Length {} >>\nstream\n{stream}\nendstream", stream.len()));
+        }
+        let mut pdf = String::from("%PDF-1.4\n");
+        let mut offsets = Vec::new();
+        for (i, o) in objs.iter().enumerate() {
+            offsets.push(pdf.len());
+            pdf += &format!("{} 0 obj\n{o}\nendobj\n", i + 1);
+        }
+        let xref = pdf.len();
+        pdf += &format!("xref\n0 {}\n0000000000 65535 f \n", objs.len() + 1);
+        for o in offsets {
+            pdf += &format!("{o:010} 00000 n \n");
+        }
+        pdf += &format!("trailer\n<< /Size {} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n", objs.len() + 1);
+        pdf.into_bytes()
+    }
+
+    /// The top of the first page on screen.
+    fn first_page_top(h: &Harness<'static, PdfCraftApp>) -> f32 {
+        h.state().views[0].screen_rects.iter().find(|(i, _)| *i == 0).map_or(f32::NEG_INFINITY, |(_, r)| r.top())
+    }
+
+    /// A finger drags from y 600 to y 300 in `moves` frames of `step` seconds, rests for `rest`
+    /// frames, then lifts; returns how far the first page moved up once it settles.
+    fn swipe(step: f32, moves: usize, rest: usize) -> f32 {
+        let mut h = Harness::builder().with_size(egui::vec2(900.0, 900.0)).with_step_dt(step).build_eframe(|_| {
+            let mut app = PdfCraftApp::new();
+            app.set_option("language", "en").unwrap();
+            app.open_bytes("long.pdf", None, long_pdf(8)).unwrap();
+            app
+        });
+        h.run_steps(8);
+        let start = first_page_top(&h);
+        let touch = |phase, y: f32| Event::Touch { device_id: TouchDeviceId(1), id: TouchId(1), phase, pos: pos2(550.0, y), force: None };
+        let at = |y: f32| pos2(550.0, y);
+        h.event(touch(TouchPhase::Start, 600.0));
+        h.event(Event::PointerMoved(at(600.0)));
+        h.event(Event::PointerButton { pos: at(600.0), button: PointerButton::Primary, pressed: true, modifiers: Default::default() });
+        h.step();
+        for k in 1..=moves {
+            let y = 600.0 - 300.0 * k as f32 / moves as f32;
+            h.event(touch(TouchPhase::Move, y));
+            h.event(Event::PointerMoved(at(y)));
+            h.step();
+        }
+        for _ in 0..rest {
+            h.step();
+        }
+        h.event(Event::PointerButton { pos: at(300.0), button: PointerButton::Primary, pressed: false, modifiers: Default::default() });
+        h.event(Event::PointerGone);
+        h.event(touch(TouchPhase::End, 300.0));
+        h.run_steps(60);
+        start - first_page_top(&h)
+    }
+
+    #[test]
+    fn a_finger_flick_scrolls_the_page_and_it_glides_on() {
+        // 300 points in a quarter of a second.
+        let moved = swipe(1.0 / 60.0, 15, 0);
+        assert!(moved > 400.0, "a 300 pt flick moved the page {moved} pt");
+    }
+
+    #[test]
+    fn it_glides_on_a_phone_with_slow_frames_too() {
+        let moved = swipe(0.1, 3, 0);
+        assert!(moved > 400.0, "a 300 pt flick at 10 frames a second moved the page {moved} pt");
+    }
+
+    #[test]
+    fn a_finger_that_stops_before_it_lifts_leaves_the_page_there() {
+        let moved = swipe(1.0 / 60.0, 15, 30);
+        assert!((290.0..=310.0).contains(&moved), "a 300 pt drag held still moved the page {moved} pt");
+    }
+}
