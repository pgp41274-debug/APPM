diff --git a/crates/ui-egui/src/widgets.rs b/crates/ui-egui/src/widgets.rs
index 85af966..b4a235b 100644
--- a/crates/ui-egui/src/widgets.rs
+++ b/crates/ui-egui/src/widgets.rs
@@ -28,15 +28,88 @@ pub fn modal(ctx: &egui::Context, id: impl std::hash::Hash + std::fmt::Debug) ->
     egui::Modal::new(egui::Id::new(id)).frame(dialog_frame(ctx))
 }
 
+/// Below this width or height (in points) the screen is small, a phone's: dialogs scroll.
+const SMALL_SCREEN: f32 = 720.0;
+
 /// Show [`modal`], outline its controls, and remember the card rect for layout checks.
+///
+/// On a small screen the contents scroll inside a card no larger than the screen, so a dialog
+/// laid out for a desktop window (Print is 820 points wide) keeps its buttons within reach.
 pub fn show_modal<R>(ctx: &egui::Context, id: &str, content: impl FnOnce(&mut egui::Ui) -> R) -> egui::ModalResponse<R> {
     let stored = egui::Id::new(id);
+    let screen = ctx.content_rect().size();
+    let small = screen.x < SMALL_SCREEN || screen.y < SMALL_SCREEN;
+    // The room a card may take: the screen less the card's padding and a margin all round.
+    let room = (screen - 2.0 * vec2(f32::from(DIALOG_PAD_X) + 8.0, f32::from(DIALOG_PAD_Y) + 8.0)).max(vec2(120.0, 120.0));
+    // The contents keep one id whether they scroll or not. The keyboard a field opens can make
+    // the screen small, and new ids would take the field's focus and close the keyboard again.
+    let body = |ui: &mut egui::Ui, builder: egui::UiBuilder| ui.scope_builder(builder.id(stored.with("body")), content).inner;
     modal(ctx, id).show(ctx, |ui| {
         begin_dialog(ui);
-        let inner = content(ui);
+        let inner = if small {
+            // The card keeps the size it had, a smaller dialog's or the one from before the
+            // keyboard closed, so it is measured again in all the room when it opens and when
+            // the screen changes: laid out at its smallest (a sizing pass) in a pass that is
+            // discarded, so the measuring never shows. An Area's own sizing pass would disable
+            // the controls, and a disabled field loses its focus.
+            let pass = ui.ctx().cumulative_pass_nr();
+            let (seen, last) = ui.ctx().data(|d| (d.get_temp::<u64>(stored.with("seen")), d.get_temp::<egui::Vec2>(stored.with("room"))));
+            let measure = seen.is_none_or(|p| p.saturating_add(1) != pass) || last != Some(room);
+            // The size the card has grown to since it was measured (see below).
+            let grow_id = stored.with("grow");
+            let grow = ui.ctx().data_mut(|d| {
+                d.insert_temp(stored.with("seen"), pass);
+                d.insert_temp(stored.with("room"), room);
+                if measure {
+                    d.remove::<egui::Vec2>(grow_id);
+                }
+                d.get_temp::<egui::Vec2>(grow_id)
+            });
+            let mut region = ui.available_rect_before_wrap();
+            let mut builder = egui::UiBuilder::new();
+            if measure {
+                ui.ctx().request_discard("dialog size");
+                region = Rect::from_min_size(region.min, room);
+                builder = builder.sizing_pass();
+            }
+            let mut scroll = egui::ScrollArea::both().id_salt(stored.with("scroll")).max_width(room.x).max_height(room.y);
+            if let Some(size) = grow {
+                scroll = scroll.min_scrolled_width(size.x).min_scrolled_height(size.y);
+            }
+            let out = ui.scope_builder(egui::UiBuilder::new().max_rect(region), |ui| scroll.show(ui, |ui| body(ui, builder))).inner;
+            if !measure {
+                // The measure comes out short (a sizing pass lays rows out at their smallest), and
+                // between measures the card could only keep its size or shrink, while more can come
+                // into it: another dialog (they all share one modal), a tab, an error line. So when
+                // the contents need more than the card gives them, the card grows to them on the
+                // next frame, up to the room there is. It grows only to what contents laid out in
+                // it take, so it never overshoots and comes to rest; contents that take all the
+                // height they get (a list that scrolls by itself) get more each frame until they
+                // have what they want.
+                let (view, content) = (out.inner_rect.size(), out.content_size);
+                let short = |view: f32, content: f32, room: f32| content > view + 0.5 && view + 0.5 < room;
+                if short(view.x, content.x, room.x) || short(view.y, content.y, room.y) {
+                    let size = content.min(room).max(grow.unwrap_or(egui::Vec2::ZERO));
+                    ui.ctx().data_mut(|d| d.insert_temp(grow_id, size));
+                    ui.ctx().request_repaint();
+                }
+            }
+            out.inner
+        } else {
+            body(ui, egui::UiBuilder::new())
+        };
         // The frame's stroke sits outside this content rect; the stored card is the fill.
         let card = ui.min_rect().expand2(egui::vec2(f32::from(DIALOG_PAD_X), f32::from(DIALOG_PAD_Y)));
-        ui.ctx().data_mut(|d| d.insert_temp(stored.with("card"), card));
+        let before = ui.ctx().data_mut(|d| {
+            let before = d.get_temp::<Rect>(stored.with("card"));
+            d.insert_temp(stored.with("card"), card);
+            before
+        });
+        // The modal is placed by the size its card had, so a card that grew or shrank is centred
+        // on the next frame. Ask for that frame: nothing else may draw one before the next input.
+        if small && before.is_some_and(|b| (b.size() - card.size()).abs().max_elem() > 0.5) {
+            ui.ctx().request_repaint();
+        }
         inner
     })
 }
