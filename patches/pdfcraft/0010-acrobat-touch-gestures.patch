+/// How long a finger rests on a word before it selects it (seconds), unless the host says
+/// otherwise ([`crate::PdfCraftApp::host_long_press`]: Android's own touch-and-hold delay).
+pub(crate) const LONG_PRESS: f64 = 0.5;
+
+/// How far a finger moves before it scrolls the page rather than resting on it (points; Android's
+/// touch slop is 8 dp).
+const TOUCH_SLOP: f32 = 8.0;
+
+/// A double tap zooms in to at most this many times the page's width ([`DocView::smart_zoom`]).
+const SMART_ZOOM_MAX: f32 = 4.0;
+/// Room left each side of the column a double tap zooms in on (screen points).
+const SMART_ZOOM_MARGIN: f32 = 8.0;
+
+/// The column of text around view point (`x`, `y`) on a page: the box of the lines within a
+/// short way above and below it that overlap it sideways (a paragraph, or one column of a
+/// two-column page). `None` far from any text.
+pub(crate) fn text_column(text: &PageText, x: f32, y: f32) -> Option<[f32; 4]> {
+    let mut lines: std::collections::BTreeMap<u32, [f32; 4]> = std::collections::BTreeMap::new();
+    for (g, line) in text.glyphs.iter().zip(&text.line_of) {
+        if g.text.trim().is_empty() || !g.rect.iter().all(|v| v.is_finite()) {
+            continue;
+        }
+        let b = lines.entry(*line).or_insert(g.rect);
+        *b = [b[0].min(g.rect[0]), b[1].min(g.rect[1]), b[2].max(g.rect[2]), b[3].max(g.rect[3])];
+    }
+    // The line under the point, or the nearest one within a few lines' height of it.
+    let distance = |b: &[f32; 4]| {
+        let dx = (b[0] - x).max(x - b[2]).max(0.0);
+        let dy = (b[1] - y).max(y - b[3]).max(0.0);
+        dx.hypot(dy)
+    };
+    let seed = *lines.values().min_by(|a, b| distance(a).total_cmp(&distance(b))).filter(|b| distance(b) <= 48.0)?;
+    // Lines around it that overlap it sideways by half the narrower of the two: the column.
+    let reach = 220.0;
+    let overlaps = |b: &[f32; 4]| {
+        let shared = b[2].min(seed[2]) - b[0].max(seed[0]);
+        shared >= 0.5 * (b[2] - b[0]).min(seed[2] - seed[0]) && b[3] >= seed[1] - reach && b[1] <= seed[3] + reach
+    };
+    let column = lines.values().filter(|b| overlaps(b)).fold(seed, |c, b| [c[0].min(b[0]), c[1].min(b[1]), c[2].max(b[2]), c[3].max(b[3])]);
+    Some(column)
+}
 
