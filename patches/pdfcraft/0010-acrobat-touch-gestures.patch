+    /// A double tap at `pos` (screen points), as in Acrobat's phone app: zoom in on the column of
+    /// text under the finger until its lines fill the screen's width (twice the page's width
+    /// where there is no text), or, on a page already zoomed in, back to the page's width. The
+    /// point tapped stays where it is on screen, and the column's left edge goes to the screen's.
+    pub(crate) fn smart_zoom(&mut self, info: &DocInfo, pos: Pos2) {
+        let Some((page, rect)) = self.screen_rects.iter().copied().find(|(_, r)| r.expand(4.0).contains(pos)) else { return };
+        let (fit, zoom) = (self.fit, self.zoom);
+        self.fit = Fit::Width;
+        self.fit_zoom(info);
+        let width_zoom = self.zoom;
+        (self.fit, self.zoom) = (fit, zoom);
+        if self.zoom > width_zoom * 1.1 {
+            self.zoom_at(width_zoom, pos);
+            self.fit = Fit::Width;
+            return;
+        }
+        let max_zoom = width_zoom * SMART_ZOOM_MAX;
+        let avail = (self.viewport_w - 2.0 * self.side).max(100.0);
+        let column = self.page_xform(page).zip(self.texts.get(&page).cloned()).and_then(|(xf, text)| {
+            let (vx, vy) = xf.screen_to_view(pos);
+            let column = text_column(&text, vx, vy)?;
+            Some(xf.view_rect(column))
+        });
+        // The zoom at which the column, with a margin each side, is as wide as the screen.
+        let target = column.filter(|c| c.width() > 1.0).map(|c| zoom * (avail - 2.0 * SMART_ZOOM_MARGIN) / c.width());
+        match (column, target) {
+            (Some(c), Some(z)) if z > width_zoom * 1.2 => {
+                // The column's left edge goes to the screen's (less the margin), at the tap's height.
+                let f = vec2((c.left() - rect.left()) / rect.width().max(1.0), (pos.y - rect.top()) / rect.height().max(1.0));
+                self.zoom = z.min(max_zoom).clamp(0.08, 64.0);
+                self.fit = Fit::None;
+                self.zoom_anchor = Some((page, f.x, f.y, vec2(self.side + SMART_ZOOM_MARGIN, pos.y - self.viewport_screen.min.y)));
+            }
+            _ => self.zoom_at((width_zoom * 2.0).min(max_zoom), pos),
+        }
+    }
+
+    /// The previous or next page in single-page view (a swipe, or a tap at the screen's edge, as
+    /// in Acrobat's phone app). A swipe turns the page only while the page fits the screen's
+    /// width: on a page zoomed in past it, a sideways drag scrolls instead. Returns whether the
+    /// page turned.
+    pub(crate) fn turn_page(&mut self, forward: bool, swipe: bool) -> bool {
+        if self.continuous {
+            return false;
+        }
+        let fits = self.screen_rects.iter().find(|(p, _)| *p == self.current).is_none_or(|(_, r)| r.width() <= self.viewport_screen.width() + 1.0);
+        if swipe && !fits {
+            return false;
+        }
+        let before = self.current;
+        self.step_page(forward);
+        self.current != before || self.goto.is_some()
+    }
