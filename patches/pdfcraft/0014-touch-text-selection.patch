+    /// A phone showing one page of "The quick brown fox", its text read.
+    fn words() -> Harness<'static, PdfCraftApp> {
+        let mut h = Harness::builder().with_size(egui::vec2(412.0, 800.0)).build_eframe(move |_| {
+            let mut app = PdfCraftApp::new();
+            app.set_option("language", "en").unwrap();
+            app.host_chrome = true;
+            app.open_bytes("words.pdf", None, crate::canvas::touch_tests::lines_pdf(&["The quick brown fox".into(), "Two".into()])).unwrap();
+            app
+        });
+        h.run_steps(8);
+        until(&mut h, |h| h.state().views[0].page_text(0).is_some());
+        h
+    }
+
+    /// The screen centre of the first glyph `letter` on the first page.
+    fn letter(h: &Harness<'static, PdfCraftApp>, letter: &str) -> egui::Pos2 {
+        let view = &h.state().views[0];
+        let (text, xf) = (view.page_text(0).expect("the page's text"), view.page_xform(0).expect("the page on screen"));
+        let g = text.glyphs.iter().find(|g| g.text == letter).unwrap_or_else(|| panic!("no {letter} on the page"));
+        xf.view_rect(g.rect).center()
+    }
+
+    fn selected(h: &Harness<'static, PdfCraftApp>) -> String {
+        state(h)["selection"]["text"].as_str().unwrap_or("").trim().to_string()
+    }
+
+    /// The finger, still down, moves to `to` over a few frames.
+    fn slide(h: &mut Harness<'static, PdfCraftApp>, from: egui::Pos2, to: egui::Pos2) {
+        for k in 1..=4 {
+            let at = from + (to - from) * (k as f32 / 4.0);
+            finger(h, 1, TouchPhase::Move, at);
+            h.event(Event::PointerMoved(at));
+            h.step();
+        }
+        h.run_steps(2);
+    }
+
+    #[test]
+    fn a_finger_held_on_a_word_then_dragged_widens_the_selection_by_words() {
+        let mut h = words();
+        pen(&mut h, false, false);
+        let top = page_top(&h);
+        let at = letter(&h, "i");
+        press(&mut h, at);
+        h.run_steps(40);
+        assert_eq!(selected(&h), "quick", "{}", state(&h));
+        assert_eq!(state(&h)["selection"]["touching"], true);
+        let at_0 = letter(&h, "w");
+        slide(&mut h, at, at_0);
+        assert_eq!(selected(&h), "quick brown", "{}", state(&h));
+        assert!(h.state().views[0].magnify.is_some(), "a magnifier shows the text under the finger");
+        let at_0 = letter(&h, "w");
+        let at_1 = letter(&h, "x");
+        slide(&mut h, at_0, at_1);
+        assert_eq!(selected(&h), "quick brown fox", "{}", state(&h));
+        // Back past the word held: that word stays, and the selection runs the other way.
+        let at_0 = letter(&h, "x");
+        let at_1 = letter(&h, "h");
+        slide(&mut h, at_0, at_1);
+        assert_eq!(selected(&h), "The quick", "{}", state(&h));
+        assert_eq!(page_top(&h), top, "the drag scrolled nothing");
+        let at_0 = letter(&h, "h");
+        lift(&mut h, at_0);
+        h.run_steps(4);
+        assert_eq!(selected(&h), "The quick", "the selection stays when the finger lifts");
+        assert_eq!(state(&h)["selection"]["touching"], false);
+        assert!(h.state().views[0].magnify.is_none(), "and the magnifier goes");
+    }
