+    #[test]
+    fn a_handle_grows_the_selection_by_words_shrinks_it_by_letters_and_crosses_the_other() {
+        let mut h = words();
+        pen(&mut h, false, false);
+        let at = letter(&h, "i");
+        press(&mut h, at);
+        h.run_steps(40);
+        lift(&mut h, at);
+        h.run_steps(4);
+        assert_eq!(selected(&h), "quick");
+        let handle = |h: &mut Harness<'static, PdfCraftApp>, end: bool, at: egui::Pos2| {
+            ask(h, HostRequest::SelectionHandle { end, x: at.x, y: at.y, done: false });
+        };
+        // Into the first half of the next word: not yet; past its middle: all of it.
+        let at_0 = letter(&h, "b");
+        handle(&mut h, true, at_0);
+        assert_eq!(selected(&h), "quick", "{}", state(&h));
+        assert_eq!(state(&h)["selection"]["moving"], "end");
+        let at_0 = letter(&h, "w");
+        handle(&mut h, true, at_0);
+        assert_eq!(selected(&h), "quick brown", "{}", state(&h));
+        assert!(h.state().views[0].magnify.is_some(), "a magnifier shows the handle's end");
+        // Drawn back: letter by letter.
+        let at_0 = letter(&h, "r");
+        handle(&mut h, true, at_0);
+        let t = selected(&h);
+        assert!(t.starts_with("quick b") && t.len() < "quick brown".len(), "{t}");
+        // On into the next word: whole words again.
+        let at_0 = letter(&h, "x");
+        handle(&mut h, true, at_0);
+        assert_eq!(selected(&h), "quick brown fox", "{}", state(&h));
+        ask(&mut h, HostRequest::SelectionHandle { end: true, x: f32::NAN, y: f32::NAN, done: true });
+        assert!(state(&h)["selection"]["moving"].is_null());
+        assert!(h.state().views[0].magnify.is_none());
+        // The end handle taken back past the start: the handles swap, and the start moves on.
+        let at_0 = letter(&h, "T");
+        handle(&mut h, true, at_0);
+        assert_eq!(selected(&h), "The", "{}", state(&h));
+        assert_eq!(state(&h)["selection"]["moving"], "start");
+        ask(&mut h, HostRequest::SelectionHandle { end: true, x: f32::NAN, y: f32::NAN, done: true });
+    }
