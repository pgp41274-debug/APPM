+    #[test]
+    fn two_fingers_landing_together_select_nothing_nor_does_a_tap_after() {
+        let mut h = phone(2);
+        let (word, _) = first_and_last_glyph(&mut h);
+        pen(&mut h, false, false);
+        // Two fingers scroll, the first of them over the text; the browser's pointer is the first.
+        let (a, b) = (word + egui::vec2(0.0, 40.0), word + egui::vec2(120.0, 40.0));
+        finger(&mut h, 1, TouchPhase::Start, a);
+        h.event(Event::PointerMoved(a));
+        h.event(Event::PointerButton { pos: a, button: PointerButton::Primary, pressed: true, modifiers: Default::default() });
+        // Both fingers land in the same frame, as they often do.
+        finger(&mut h, 2, TouchPhase::Start, b);
+        h.step();
+        for k in 1..=4 {
+            let d = egui::vec2(0.0, -10.0 * k as f32);
+            finger(&mut h, 1, TouchPhase::Move, a + d);
+            finger(&mut h, 2, TouchPhase::Move, b + d);
+            h.event(Event::PointerMoved(a + d));
+            h.step();
+        }
+        let end = a + egui::vec2(0.0, -40.0);
+        h.event(Event::PointerButton { pos: end, button: PointerButton::Primary, pressed: false, modifiers: Default::default() });
+        h.event(Event::PointerGone);
+        finger(&mut h, 1, TouchPhase::End, end);
+        finger(&mut h, 2, TouchPhase::End, b + egui::vec2(0.0, -40.0));
+        h.step();
+        assert!(state(&h)["selection"].is_null(), "two fingers scrolling selected nothing: {}", state(&h));
+        // A finger's tap on the word right after: no double tap, no selection.
+        press(&mut h, word);
+        h.step();
+        lift(&mut h, word);
+        h.run_steps(6);
+        assert!(state(&h)["selection"].is_null(), "the tap after the scroll selected nothing: {}", state(&h));
+    }
+
