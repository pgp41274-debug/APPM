+    use egui::{Event, PointerButton, TouchDeviceId, TouchId, TouchPhase, pos2};
+
+    /// Frames until the first page's text is known; the screen centres of its first and last glyphs.
+    fn first_and_last_glyph(h: &mut Harness<'static, PdfCraftApp>) -> (egui::Pos2, egui::Pos2) {
+        until(h, |h| h.state().views[0].page_text(0).is_some());
+        let view = &h.state().views[0];
+        let (text, xf) = (view.page_text(0).expect("the page's text"), view.page_xform(0).expect("the page on screen"));
+        let first = text.glyphs.first().expect("a glyph").rect;
+        let last = text.glyphs.last().expect("a glyph").rect;
+        (xf.view_rect(first).center(), xf.view_rect(last).center())
+    }
+
+    /// Frames until `done`, for up to 20 seconds: page text is read on worker threads, which a
+    /// busy machine (every test at once) can keep waiting longer than a fixed number of frames.
+    fn until(h: &mut Harness<'static, PdfCraftApp>, done: impl Fn(&Harness<'static, PdfCraftApp>) -> bool) {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+        while !done(h) && std::time::Instant::now() < deadline {
+            h.step();
+            std::thread::sleep(std::time::Duration::from_millis(2));
+        }
+    }
+
+    fn finger(h: &mut Harness<'static, PdfCraftApp>, id: u64, phase: TouchPhase, at: egui::Pos2) {
+        h.event(Event::Touch { device_id: TouchDeviceId(1), id: TouchId(id), phase, pos: at, force: None });
+    }
+
+    /// One finger down at `at` (with the pointer events a browser sends for it).
+    fn press(h: &mut Harness<'static, PdfCraftApp>, at: egui::Pos2) {
+        finger(h, 1, TouchPhase::Start, at);
+        h.event(Event::PointerMoved(at));
+        h.event(Event::PointerButton { pos: at, button: PointerButton::Primary, pressed: true, modifiers: Default::default() });
+    }
+
+    fn lift(h: &mut Harness<'static, PdfCraftApp>, at: egui::Pos2) {
+        h.event(Event::PointerButton { pos: at, button: PointerButton::Primary, pressed: false, modifiers: Default::default() });
+        h.event(Event::PointerGone);
+        finger(h, 1, TouchPhase::End, at);
+    }
