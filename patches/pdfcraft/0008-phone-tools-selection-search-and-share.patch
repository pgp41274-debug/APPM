+    /// Move one end of the text selection to the text nearest `pos` (screen points) on the
+    /// selection's page; the other end stays. A selection can't span pages.
+    pub(crate) fn move_selection_end(&mut self, end: bool, pos: Pos2) {
+        let Some(sel) = self.selection else { return };
+        let Span::Run { anchor, head } = sel.span else { return };
+        let (Some(text), Some(xf)) = (self.texts.get(&sel.page), self.page_xform(sel.page)) else { return };
+        let (vx, vy) = xf.screen_to_view(pos);
+        let Some(to) = text.nearest(vx, vy) else { return };
+        let (lo, hi) = (anchor.min(head), anchor.max(head));
+        let (lo, hi) = if end { (lo, to.max(lo)) } else { (to.min(hi), hi) };
+        self.selection = Some(Selection::run(sel.page, lo, hi));
+    }
