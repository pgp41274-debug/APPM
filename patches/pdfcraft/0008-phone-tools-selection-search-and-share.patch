+        let mut h = phone(2);
+        ask(&mut h, HostRequest::Command("comment.highlight".into()));
+        ask(&mut h, HostRequest::Style { color: Some([1.0, 0.0, 0.0]), width: None, opacity: Some(0.5) });
+        let s = state(&h);
+        assert_eq!(s["style"]["color"], "#ff0000");
+        assert_eq!(s["style"]["opacity"], 0.5);
+        ask(&mut h, HostRequest::Select);
+        assert!(state(&h)["style"].is_null());
+
+        ask(&mut h, HostRequest::Find("Page".into()));
+        until(&mut h, |h| state(h)["find"]["matches"] == 2);
+        assert_eq!(state(&h)["find"]["matches"], 2);
+        assert_eq!(state(&h)["find"]["current"], 1);
+        ask(&mut h, HostRequest::FindStep(true));
+        assert_eq!(state(&h)["find"]["current"], 2);
+        ask(&mut h, HostRequest::FindClose);
+        assert!(state(&h)["find"].is_null());
+
+        ask(&mut h, HostRequest::Night(true));
+        assert_eq!(state(&h)["night"], true);
+        ask(&mut h, HostRequest::Night(false));
+        assert_eq!(state(&h)["night"], false);
+
+        // A sticky note: a tap pins it, the host's box writes it.
+        ask(&mut h, HostRequest::Command("comment.note".into()));
+        let at = pos2(200.0, 400.0);
+        h.event(Event::PointerMoved(at));
+        h.event(Event::PointerButton { pos: at, button: PointerButton::Primary, pressed: true, modifiers: Default::default() });
+        h.step();
+        h.event(Event::PointerButton { pos: at, button: PointerButton::Primary, pressed: false, modifiers: Default::default() });
+        h.run_steps(4);
+        assert_eq!(state(&h)["composer"]["kind"], "note", "{}", state(&h));
+        assert!(h.query_by_label("Post").is_none(), "PdfCraft's own card stays hidden");
+        ask(&mut h, HostRequest::ComposerText("Check this".into()));
+        assert_eq!(state(&h)["composer"]["text"], "Check this");
+        ask(&mut h, HostRequest::ComposerDone(true));
+        h.run_steps(4);
+        assert!(state(&h)["composer"].is_null());
+        assert_eq!(state(&h)["undo"], true, "the note was added");
+
+        let shared = std::sync::Arc::new(std::sync::Mutex::new(None));
+        let sink = shared.clone();
+        h.state_mut().host_share = Some(Box::new(move |name: &str, bytes: &[u8]| {
+            *sink.lock().unwrap() = Some((name.to_string(), bytes.to_vec()));
+            Ok(())
+        }));
+        ask(&mut h, HostRequest::Share);
+        let (name, bytes) = shared.lock().unwrap().take().expect("the document was shared");
+        assert_eq!(name, "long.pdf");
+        assert!(bytes.starts_with(b"%PDF-"));
+    }
 }
