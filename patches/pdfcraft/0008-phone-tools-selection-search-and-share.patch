+    /// the selected text. `None` without a selection on a page that is drawn.
+    pub(crate) fn selection_on_screen(&self) -> Option<(Rect, Pos2, Pos2, String)> {
+        let sel = self.selection?;
+        let text = self.texts.get(&sel.page)?;
+        let xf = self.page_xform(sel.page)?;
+        let rects: Vec<Rect> = sel.rects(text).into_iter().map(|r| xf.view_rect(r)).collect();
+        let (first, last) = (rects.first()?, rects.last()?);
+        let bounds = rects.iter().fold(*first, |a, b| a.union(*b));
+        let words = sel.text(text);
+        (!words.is_empty()).then(|| (bounds, first.left_bottom(), last.right_bottom(), words))
+    }
