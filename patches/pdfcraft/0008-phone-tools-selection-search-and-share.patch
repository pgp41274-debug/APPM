+
+    #[test]
+    fn two_fingers_scroll_the_page_while_the_pen_draws_with_one() {
+        let mut h = phone(8);
+        ask(&mut h, HostRequest::Command("comment.ink".into()));
+        let top = |h: &Harness<'static, PdfCraftApp>| {
+            h.state().views[0].visible_page_rects().iter().find(|(p, _)| *p == 0).map_or(f32::NEG_INFINITY, |(_, r)| r.top())
+        };
+        let before = top(&h);
+        let (a, b) = (pos2(150.0, 600.0), pos2(260.0, 600.0));
+        press(&mut h, a);
+        finger(&mut h, 2, TouchPhase::Start, b);
+        h.step();
+        for k in 1..=10 {
+            let dy = -30.0 * k as f32;
+            finger(&mut h, 1, TouchPhase::Move, a + egui::vec2(0.0, dy));
+            finger(&mut h, 2, TouchPhase::Move, b + egui::vec2(0.0, dy));
+            h.event(Event::PointerMoved(a + egui::vec2(0.0, dy)));
+            h.step();
+        }
+        finger(&mut h, 2, TouchPhase::End, b + egui::vec2(0.0, -300.0));
+        lift(&mut h, a + egui::vec2(0.0, -300.0));
+        h.run_steps(8);
+        let moved = before - top(&h);
+        assert!(moved > 150.0, "the page scrolled with the fingers ({moved})");
+        assert_eq!(state(&h)["undo"], false, "and no stroke was drawn");
+    }
