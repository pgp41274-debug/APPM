@@ -0,0 +1,212 @@
+//! A page that draws PdfCraft's controls itself (`?chrome=host`): a phone's toolbars, built by
+//! the embedding page around the canvas. PdfCraft shows the page, its dialogs, the command
+//! palette and, as a sheet from the bottom, the open panel. The page drives PdfCraft with
+//! [`HostRequest`]s and draws its controls from the state [`PdfCraftApp::host_state_json`]
+//! reports every frame.
+
+use crate::{HostRequest, PdfCraftApp, QuickTool, RightPanel, canvas, combine_ui, dialogs, palette, panels, theme, widgets};
+
+/// Room beside the pages when the host draws the controls (points).
+const HOST_SIDE: f32 = 8.0;
+
+/// The panels a host can open, by the names [`PdfCraftApp::host_state_json`] reports.
+const PANELS: [RightPanel; 7] = [
+    RightPanel::Comments,
+    RightPanel::Bookmarks,
+    RightPanel::Pages,
+    RightPanel::Fields,
+    RightPanel::Layers,
+    RightPanel::Attachments,
+    RightPanel::Signatures,
+];
+
+fn panel_named(name: &str) -> Option<RightPanel> {
+    PANELS.into_iter().find(|p| format!("{p:?}") == name)
+}
+
+/// The active tool as the command that picks it (`comment.highlight`, `sign.fill.text`, ...), so
+/// a host marks the button that ran it; `select` and `hand` for the two that have none.
+pub(crate) fn tool_id(tool: QuickTool) -> String {
+    match tool {
+        QuickTool::Select => "select".to_string(),
+        QuickTool::Hand => "hand".to_string(),
+        QuickTool::Comment(t) => t.command().to_string(),
+        QuickTool::Fill(f) => f.command().to_string(),
+        QuickTool::Field(f) => f.command().to_string(),
+        QuickTool::Measure(m) => format!("measure.{}", m.name()),
+        QuickTool::Crop => "page.crop".to_string(),
+        QuickTool::Redact => "redact.mark".to_string(),
+        QuickTool::AddText => "edit.text".to_string(),
+        QuickTool::EditText => "edit.edit_text".to_string(),
+        QuickTool::Link => "edit.link".to_string(),
+        QuickTool::MarqueeZoom => "view.marquee_zoom".to_string(),
+        QuickTool::Snapshot => "edit.snapshot".to_string(),
+        QuickTool::ColumnSelect => "edit.column_select".to_string(),
+        QuickTool::Stamp(_) | QuickTool::CustomStamp(_) => "comment.stamp".to_string(),
+        QuickTool::EnhanceCamera => "ocr.enhance_camera".to_string(),
+        QuickTool::SignArea { certify: false } => "sign.digital".to_string(),
+        QuickTool::SignArea { certify: true } => "sign.certify".to_string(),
+    }
+}
+
+impl PdfCraftApp {
+    /// Carry out what the host asked for since the last frame.
+    pub(crate) fn host_requests_tick(&mut self) {
+        let requests = self.host_requests.lock().map(|mut q| std::mem::take(&mut *q)).unwrap_or_default();
+        for request in requests {
+            match request {
+                HostRequest::Command(id) => self.run_command(&id),
+                HostRequest::Select => self.quick_tool = QuickTool::Select,
+                HostRequest::Panel(name) => {
+                    let panel = name.as_deref().and_then(panel_named);
+                    // A name PdfCraft doesn't know closes nothing and opens nothing.
+                    if name.is_none() || panel.is_some() {
+                        self.choose_right_panel(panel);
+                    }
+                }
+                HostRequest::Activate(doc) => {
+                    if let Some(i) = self.views.iter().position(|v| v.id.0 == doc) {
+                        self.active = Some(i);
+                    }
+                }
+                HostRequest::GotoPage(page) => {
+                    if let Some(i) = self.active
+                        && let Some(pages) = self.session.get(self.views[i].id).map(|d| d.info.pages.len())
+                        && pages > 0
+                    {
+                        self.views[i].goto = Some((page.clamp(1, pages) - 1, 0.0));
+                    }
+                }
+            }
+        }
+    }
+
+    /// What a host needs to draw its controls (see [`crate::HostStateFn`]).
+    pub(crate) fn host_state_json(&self) -> serde_json::Value {
+        use serde_json::json;
+        let docs: Vec<serde_json::Value> = self
+            .views
+            .iter()
+            .enumerate()
+            .filter_map(|(i, v)| {
+                let doc = self.session.get(v.id)?;
+                // The file's name, as phone apps show it; `title` is what the PDF asks a window to show.
+                Some(json!({ "doc": v.id.0, "name": doc.name, "title": doc.display_name(), "dirty": self.has_unsaved_work(i) }))
+            })
+            .collect();
+        let active = self.active.and_then(|i| self.views.get(i));
+        let pages = active.and_then(|v| self.session.get(v.id)).map_or(0, |d| d.info.pages.len());
+        let enabled = |id: &str| pdfcraft_engine::commands::command(id).is_some_and(|c| self.command_enabled(c));
+        json!({
+            "docs": docs,
+            "active": active.map(|v| v.id.0),
+            "page": active.map_or(0, |v| v.current.saturating_add(1).min(pages)),
+            "pages": pages,
+            "zoom": active.map_or(0, |v| (v.zoom * 100.0).round() as i64),
+            "continuous": active.is_some_and(|v| v.continuous),
+            "tool": tool_id(self.quick_tool),
+            "panel": self.right.filter(|p| PANELS.contains(p)).map(|p| format!("{p:?}")),
+            "undo": enabled("edit.undo"),
+            "redo": enabled("edit.redo"),
+            "save": enabled("file.save"),
+            "fullScreen": self.full_screen,
+            "busy": self.dialog.is_some() || self.palette_open,
+        })
+    }
+
+    /// The frame when the host draws the controls: the open panel as a sheet from the bottom,
+    /// the page above it, and what PdfCraft draws over the page.
+    pub(crate) fn host_chrome_ui(&mut self, ui: &mut egui::Ui, ctx: &egui::Context) {
+        let t = theme::Tokens::get(ctx);
+        // No floating quick-action bar to keep the pages clear of: a phone's width is the page's.
+        for view in &mut self.views {
+            view.side = HOST_SIDE;
+        }
+        if self.active.is_some() && self.right.is_some_and(|p| PANELS.contains(&p)) {
+            let height = ui.max_rect().height();
+            egui::Panel::bottom("host_panel")
+                .resizable(true)
+                .default_size(height * 0.45)
+                .size_range(120.0..=(height * 0.85).max(120.0))
+                .frame(egui::Frame::NONE.fill(t.panel).stroke(egui::Stroke::new(1.0, t.divider)))
+                .show(ui, |ui| panels::right_panel(self, ui));
+        }
+        egui::CentralPanel::default().frame(egui::Frame::NONE.fill(t.pasteboard)).show(ui, |ui| match self.active {
+            Some(index) => canvas::document_area(self, index, ui),
+            None if self.combine_showing() => combine_ui::page(self, ui),
+            // The host shows its own start screen.
+            None => {}
+        });
+        self.process_pending_edits();
+        palette::show(self, ctx);
+        dialogs::show(self, ctx);
+        self.show_progress(ctx);
+        widgets::toast(self, ctx);
+        self.finish_render_frame(ctx);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use crate::{HostRequest, PdfCraftApp};
+    use egui_kittest::{Harness, kittest::Queryable};
+
+    fn phone(pages: usize) -> Harness<'static, PdfCraftApp> {
+        let mut h = Harness::builder().with_size(egui::vec2(412.0, 800.0)).build_eframe(move |_| {
+            let mut app = PdfCraftApp::new();
+            app.set_option("language", "en").unwrap();
+            app.host_chrome = true;
+            app.open_bytes("long.pdf", None, crate::canvas::touch_tests::long_pdf(pages)).unwrap();
+            app
+        });
+        h.run_steps(8);
+        h
+    }
+
+    fn ask(h: &mut Harness<'static, PdfCraftApp>, request: HostRequest) {
+        h.state().host_requests.lock().unwrap().push(request);
+        h.run_steps(4);
+    }
+
+    fn state(h: &Harness<'static, PdfCraftApp>) -> serde_json::Value {
+        h.state().host_state_json()
+    }
+
+    #[test]
+    fn the_host_draws_the_controls_and_pdfcraft_only_the_page() {
+        let h = phone(3);
+        // None of PdfCraft's own chrome: the tab strip's Open, the rail, the tool strip.
+        assert!(h.query_by_label("Open").is_none());
+        assert!(h.query_by_label("Comments").is_none());
+        assert!(h.query_by_label_contains("Zoom in").is_none());
+        let s = state(&h);
+        assert_eq!(s["pages"], 3);
+        assert_eq!(s["page"], 1);
+        assert_eq!(s["tool"], "select");
+        assert_eq!(s["docs"][0]["name"], "long.pdf");
+        assert_eq!(s["docs"][0]["doc"], s["active"]);
+        assert_eq!(s["undo"], false);
+    }
+
+    #[test]
+    fn host_requests_pick_tools_open_panels_and_turn_pages() {
+        let mut h = phone(3);
+        ask(&mut h, HostRequest::Command("comment.highlight".into()));
+        assert_eq!(state(&h)["tool"], "comment.highlight");
+        // Picking a comment tool on a phone opens no panel over the page.
+        assert!(state(&h)["panel"].is_null());
+        ask(&mut h, HostRequest::Select);
+        assert_eq!(state(&h)["tool"], "select");
+        ask(&mut h, HostRequest::Panel(Some("Pages".into())));
+        assert_eq!(state(&h)["panel"], "Pages");
+        ask(&mut h, HostRequest::Panel(Some("Nonsense".into())));
+        assert_eq!(state(&h)["panel"], "Pages");
+        ask(&mut h, HostRequest::Panel(None));
+        assert!(state(&h)["panel"].is_null());
+        ask(&mut h, HostRequest::GotoPage(3));
+        h.run_steps(8);
+        assert_eq!(state(&h)["page"], 3);
+        ask(&mut h, HostRequest::Command("page.rotate".into()));
+        assert_eq!(state(&h)["undo"], true);
+    }
+}
