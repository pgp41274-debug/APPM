+
+#[cfg(test)]
+mod host_close_tests {
+    use crate::PdfCraftApp;
+    use std::sync::{Arc, Mutex};
+
+    type Reports = Arc<Mutex<Vec<(Option<String>, Option<u64>)>>>;
+
+    /// An app in an embedding page that hears every close.
+    fn app() -> (PdfCraftApp, Reports) {
+        let mut app = PdfCraftApp::new();
+        let reports = Reports::default();
+        let sink = reports.clone();
+        app.host_closed = Some(Box::new(move |id, doc| sink.lock().unwrap().push((id.map(str::to_string), doc))));
+        (app, reports)
+    }
+
+    /// The closes reported since the last call.
+    fn taken(reports: &Reports) -> Vec<(Option<String>, Option<u64>)> {
+        std::mem::take(&mut *reports.lock().unwrap())
+    }
+
+    fn sent(id: &str) -> Option<String> {
+        Some(id.to_string())
+    }
+
+    fn form() -> Vec<u8> {
+        include_bytes!("../tests/data/form.pdf").to_vec()
+    }
+
+    /// The form, protected with the open password "pw".
+    fn locked_form() -> Vec<u8> {
+        let mut doc = pdfcraft_cos::Document::open(Arc::new(form())).unwrap();
+        doc.set_encryption(&pdfcraft_cos::NewEncryption {
+            algorithm: pdfcraft_cos::Algorithm::Aes256,
+            user_password: "pw",
+            owner_password: "owner",
+            permissions: -1,
+            encrypt_metadata: true,
+            seed: [3; 32],
+        })
+        .unwrap();
+        pdfcraft_cos::write_full(&doc, &Default::default()).unwrap()
+    }
+
+    #[test]
+    fn closed_tabs_are_reported_with_the_page_id_and_number() {
+        let (mut app, reports) = app();
+        app.open_bytes_with_focus("sent.pdf", None, form(), true, sent("f1")).unwrap();
+        app.open_bytes("picked.pdf", None, form()).unwrap();
+        app.open_bytes("other.pdf", None, form()).unwrap();
+        let docs: Vec<u64> = app.views.iter().map(|v| v.id.0).collect();
+        assert!(taken(&reports).is_empty(), "opening reports nothing");
+        app.request_close_tab(1);
+        assert_eq!(taken(&reports), [(None, Some(docs[1]))]);
+        app.close_all();
+        assert_eq!(taken(&reports), [(None, Some(docs[2])), (sent("f1"), Some(docs[0]))]);
+        assert!(app.views.is_empty() && app.host_ids.is_empty());
+    }
+
+    #[test]
+    fn files_that_never_become_their_own_document_are_reported_by_id() {
+        let (mut app, reports) = app();
+        assert!(app.open_bytes_with_focus("broken.pdf", None, b"not a PDF".to_vec(), true, sent("f1")).is_err());
+        assert_eq!(taken(&reports), [(sent("f1"), None)], "a file that can't be opened");
+
+        // An image or text file becomes a new PDF, which is not the page's file.
+        app.open_bytes_with_focus("notes.txt", None, b"Hello".to_vec(), true, sent("f2")).unwrap();
+        assert_eq!(taken(&reports), [(sent("f2"), None)], "a file that became a new PDF");
+        assert!(app.views.len() == 1 && app.host_ids.is_empty());
+
+        // A password prompt that goes away unanswered: cancelled, or replaced by another file.
+        app.open_bytes_with_focus("locked.pdf", None, locked_form(), true, sent("f3")).unwrap();
+        app.submit_password(Some("wrong".into()));
+        assert!(app.password_prompt.is_some() && taken(&reports).is_empty(), "a wrong password asks again");
+        app.submit_password(None);
+        assert_eq!(taken(&reports), [(sent("f3"), None)], "a cancelled password prompt");
+        app.open_bytes_with_focus("locked.pdf", None, locked_form(), true, sent("f4")).unwrap();
+        app.open_bytes("plain.pdf", None, form()).unwrap();
+        assert!(app.password_prompt.is_none());
+        assert_eq!(taken(&reports), [(sent("f4"), None)], "a password prompt another file replaced");
+    }
+
+    #[test]
+    fn an_unlocked_file_keeps_its_page_id_until_its_tab_closes() {
+        let (mut app, reports) = app();
+        app.open_bytes_with_focus("locked.pdf", None, locked_form(), true, sent("f1")).unwrap();
+        app.submit_password(Some("pw".into()));
+        assert!(app.password_prompt.is_none() && taken(&reports).is_empty());
+        let doc = app.views[0].id;
+        assert_eq!(app.host_ids.get(&doc).map(String::as_str), Some("f1"));
+        app.close_tab(0);
+        assert_eq!(taken(&reports), [(sent("f1"), Some(doc.0))]);
+    }
+}
