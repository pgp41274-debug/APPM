+    #[test]
+    fn a_file_the_page_sends_comes_to_the_front() {
+        let (mut app, reports) = app();
+        app.open_bytes("picked.pdf", None, form()).unwrap();
+        app.open_bytes("other.pdf", None, form()).unwrap();
+        app.active = Some(0);
+        app.host_inbox.lock().unwrap().push(("sent.pdf".into(), sent("f1"), form()));
+        app.open_from_host();
+        assert_eq!(app.views.len(), 3);
+        assert_eq!(app.active, Some(2), "the file just sent is the one shown");
+        assert_eq!(app.host_ids.get(&app.views[2].id).map(String::as_str), Some("f1"));
+        assert!(taken(&reports).is_empty());
+    }
