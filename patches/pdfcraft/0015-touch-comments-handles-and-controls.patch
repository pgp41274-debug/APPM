+
+/// How far from a handle a press still takes it (points): `mouse` for a mouse, more for a pen
+/// and a finger.
+pub(crate) fn grab(ui: &egui::Ui, mouse: f32) -> f32 {
+    match press_kind(ui) {
+        PressKind::Mouse => mouse,
+        PressKind::Pen => mouse.max(PEN_GRAB),
+        PressKind::Finger => mouse.max(FINGER_GRAB),
+    }
