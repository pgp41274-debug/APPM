+/// Rows and buttons of PdfCraft's own dialogs, menus and panels as tall as a finger needs (egui's
+/// are a mouse's 18 points); Android asks for 48 dp, phone apps' dense lists go to about 36.
+const TOUCH_ROW: f32 = 36.0;
+
+/// Size the stock controls for a finger, once for each theme egui keeps a style for (a theme
+/// change sets them afresh, so this runs every frame and returns at once when it is done).
+fn touch_sized(ctx: &egui::Context) {
+    if ctx.global_style().spacing.interact_size.y >= TOUCH_ROW {
+        return;
+    }
+    ctx.all_styles_mut(|s| {
+        s.spacing.interact_size.y = TOUCH_ROW;
+        s.spacing.button_padding = egui::vec2(12.0, 8.0);
+        s.spacing.item_spacing.y = s.spacing.item_spacing.y.max(8.0);
+        s.spacing.icon_width = 20.0;
+        s.spacing.icon_width_inner = 12.0;
+        s.spacing.icon_spacing = 8.0;
+        s.spacing.combo_height = s.spacing.combo_height.max(320.0);
+        s.spacing.slider_rail_height = 6.0;
+    });
+}
