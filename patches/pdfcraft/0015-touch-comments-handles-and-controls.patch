+pub(crate) fn nearest_handle(handles: impl IntoIterator<Item = Pos2>, body: Rect, p: Pos2, reach: f32, mouse: f32) -> Option<usize> {
+    let (i, d) = handles.into_iter().enumerate().map(|(i, h)| (i, h.distance(p))).min_by(|a, b| a.1.total_cmp(&b.1))?;
