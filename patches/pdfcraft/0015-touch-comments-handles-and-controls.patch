+
+/// What made the latest press on the page: a mouse (or trackpad), a pen or a finger. The canvas
+/// notes it every frame, from the browser's `pointerType` when the host draws the controls and
+/// from egui's touches otherwise.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(crate) enum PressKind {
+    #[default]
+    Mouse,
+    Pen,
+    Finger,
+}
+
+pub(crate) fn note_press_kind(ctx: &egui::Context, kind: PressKind) {
+    ctx.data_mut(|d| d.insert_temp(press_kind_id(), kind));
