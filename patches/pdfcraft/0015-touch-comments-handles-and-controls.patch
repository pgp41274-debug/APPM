+
+pub(crate) fn press_kind(ui: &egui::Ui) -> PressKind {
+    let noted = ui.ctx().data(|d| d.get_temp::<PressKind>(press_kind_id())).unwrap_or_default();
+    if noted == PressKind::Mouse && ui.input(|i| i.any_touches()) { PressKind::Finger } else { noted }
