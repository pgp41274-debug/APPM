+    /// A pen's drag as the browser sends it: pointer events only, no touch events (the shell keeps
+    /// a pen's contact out of them).
+    fn pen_drag(h: &mut Harness<'static, PdfCraftApp>, from: egui::Pos2, to: egui::Pos2, steps: usize) {
+        h.event(Event::PointerMoved(from));
+        h.event(Event::PointerButton { pos: from, button: PointerButton::Primary, pressed: true, modifiers: Default::default() });
+        h.step();
+        for k in 1..=steps {
+            let at = from + (to - from) * (k as f32 / steps as f32);
+            h.event(Event::PointerMoved(at));
+            h.step();
+        }
+        h.event(Event::PointerButton { pos: to, button: PointerButton::Primary, pressed: false, modifiers: Default::default() });
+        h.event(Event::PointerGone);
+        h.run_steps(4);
+    }
