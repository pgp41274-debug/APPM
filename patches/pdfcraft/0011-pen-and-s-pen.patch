+    /// The browser's word on the next press: a pen (`pen`), with its side button held or not.
+    fn pen(h: &mut Harness<'static, PdfCraftApp>, pen: bool, button: bool) {
+        use std::sync::atomic::Ordering::Relaxed;
+        h.state().host_pointer_pen.store(pen, Relaxed);
+        h.state().host_pen_button.store(button, Relaxed);
+        h.state().host_pointer_touch.store(!pen, Relaxed);
+    }
+
+    /// A press at `from` dragged to `to` in `steps` frames, then lifted.
+    fn drag(h: &mut Harness<'static, PdfCraftApp>, from: egui::Pos2, to: egui::Pos2, steps: usize) {
+        press(h, from);
+        h.step();
+        for k in 1..=steps {
+            let at = from + (to - from) * (k as f32 / steps as f32);
+            finger(h, 1, TouchPhase::Move, at);
+            h.event(Event::PointerMoved(at));
+            h.step();
+        }
+        lift(h, to);
+        h.run_steps(4);
+    }
+
+    fn inks(h: &Harness<'static, PdfCraftApp>) -> usize {
+        let app = h.state();
+        app.session.get(app.views[0].id).map_or(0, |d| d.info.annotations.iter().filter(|a| a.subtype == "Ink").count())
+    }
+
+    fn page_top(h: &Harness<'static, PdfCraftApp>) -> f32 {
+        h.state().views[0].visible_page_rects().iter().find(|(p, _)| *p == 0).map_or(f32::NEG_INFINITY, |(_, r)| r.top())
+    }
+
