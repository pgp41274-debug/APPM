+        assert_eq!(s["pen"], true, "and the host hears a pen is in use");
+        assert!((page_top(&h) - before).abs() < 1.0, "the page did not scroll");
+        // With the highlighter, the same quick stroke highlights what it crossed.
+        ask(&mut h, HostRequest::Select);
